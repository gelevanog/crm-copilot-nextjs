{
  "name": "crm-copilot",
  "version": "1.0.0",
  "private": true,
  "description": "A small multi-tenant CRM with an LLM copilot: tool calling, structured outputs, NL filters, rate limiting and usage accounting.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @crm/shared build && pnpm --parallel --filter @crm/api --filter @crm/web dev",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @crm/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @crm/shared build && pnpm --filter @crm/api test",
    "db:up": "docker compose up -d db",
    "db:seed": "pnpm --filter @crm/api db:seed",
    "db:deploy": "pnpm --filter @crm/api db:deploy",
    "db:migrate": "pnpm --filter @crm/api prisma:migrate",
    "transcript": "pnpm --filter @crm/api transcript"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "~15.5.4",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "prisma",
      "sharp",
      "@nestjs/core",
      "unrs-resolver"
    ]
  }
}
