# ---------------------------------------------------------------------------
# CRM Copilot configuration. Copy to apps/api/.env (API) and apps/web/.env.local
# (web) for local development. docker-compose.yml reads the same names from
# your shell or a root .env file. Every API variable is validated with Zod at
# startup (apps/api/src/config/env.ts); invalid config fails fast.
# ---------------------------------------------------------------------------

# ----- API: server ----------------------------------------------------------
# development | test | production
NODE_ENV=development
# HTTP port of the NestJS API
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable logs (pino-pretty) instead of JSON lines
LOG_PRETTY=true
# Comma-separated origins allowed by CORS (the web app talks to the API server-side,
# so this only matters if you call the API from a browser directly)
CORS_ORIGIN=http://localhost:3000

# ----- API: database --------------------------------------------------------
# PostgreSQL connection string (docker compose exposes Postgres on 5433)
DATABASE_URL=postgresql://crm:crm@localhost:5433/crm?schema=public
# Used only by the test suite; DB-backed tests are skipped if it is unreachable
TEST_DATABASE_URL=postgresql://crm:crm@localhost:5433/crm_test?schema=public

# ----- API: auth (demo) -----------------------------------------------------
# HMAC secret for the demo JWTs (min 16 chars). Change it outside local dev.
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime in seconds (default 12h)
JWT_TTL_SECONDS=43200

# ----- API: LLM provider ----------------------------------------------------
# fake (deterministic, no key) | anthropic | openai
LLM_PROVIDER=fake

# Required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Anthropic model id
ANTHROPIC_MODEL=claude-sonnet-5
# Reasoning effort for chat turns: low | medium | high
ANTHROPIC_EFFORT=medium

# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=
# OpenAI model id (Chat Completions API)
OPENAI_MODEL=gpt-5-mini
# Optional: OpenAI-compatible endpoint (Azure OpenAI proxy, gateway, ...)
# OPENAI_BASE_URL=

# Per-request timeout for provider calls (ms)
LLM_TIMEOUT_MS=60000
# max_tokens / max_completion_tokens per model call
LLM_MAX_OUTPUT_TOKENS=4096
# Optional price override in USD per 1M tokens, for models missing from
# apps/api/src/ai/llm/pricing.ts. Set both or neither.
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=

# ----- API: AI safety -------------------------------------------------------
# Max model turns per chat request (tool-calling loop guard)
AI_MAX_TOOL_ITERATIONS=5
# Per-workspace token bucket: burst size and refill rate for AI endpoints
AI_RATE_LIMIT_CAPACITY=20
AI_RATE_LIMIT_REFILL_PER_MINUTE=10

# ----- API: container only --------------------------------------------------
# Seed demo data on container start if the database is empty
SEED_ON_START=true

# ----- Web (Next.js) ---------------------------------------------------------
# API base URL as seen from the Next.js server (http://api:4000 inside compose)
API_URL=http://localhost:4000
# Mark the session cookie Secure (set true when served over HTTPS)
COOKIE_SECURE=false

# ----- docker compose host ports --------------------------------------------
WEB_PORT=3000
API_PORT=4000
DB_PORT=5433
