// CRM data model. Every business table carries `workspaceId`; the API always
// filters on it, and the AI tools reuse the same services, so the model can
// never reach another tenant's rows.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
}

enum AiFeature {
  chat
  follow_up_email
  notes_summary
  nl_filter
}

enum ConversationMessageRole {
  user
  assistant
  tool_results
  note
}

enum ProposedActionKind {
  deal_stage_change
  deal_update
  activity
}

enum ProposedActionStatus {
  pending
  approved
  rejected
  expired
  stale
}

model Workspace {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  createdAt       DateTime         @default(now())
  users           User[]
  companies       Company[]
  contacts        Contact[]
  deals           Deal[]
  activities      Activity[]
  aiUsage         AiUsage[]
  conversations   Conversation[]
  proposedActions ProposedAction[]
}

model User {
  id              String           @id @default(cuid())
  workspaceId     String
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email           String           @unique
  name            String
  passwordHash    String
  createdAt       DateTime         @default(now())
  deals           Deal[]
  activities      Activity[]
  aiUsage         AiUsage[]
  conversations   Conversation[]
  proposedActions ProposedAction[]

  @@index([workspaceId])
}

model Company {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  domain      String?
  industry    String?
  employees   Int?
  city        String?
  country     String?
  createdAt   DateTime   @default(now())
  contacts    Contact[]
  deals       Deal[]
  activities  Activity[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Contact {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  email       String
  title       String?
  phone       String?
  createdAt   DateTime   @default(now())
  deals       Deal[]
  activities  Activity[]

  @@index([workspaceId, companyId])
}

model Deal {
  id                String     @id @default(cuid())
  workspaceId       String
  workspace         Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyId         String
  company           Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId         String?
  contact           Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId           String
  owner             User       @relation(fields: [ownerId], references: [id])
  title             String
  /// Whole US dollars.
  amount            Int
  stage             DealStage
  stageChangedAt    DateTime
  expectedCloseDate DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  activities        Activity[]

  @@index([workspaceId, stage])
  @@index([workspaceId, companyId])
}

model Activity {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type        ActivityType
  subject     String
  body        String?
  occurredAt  DateTime
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  companyId   String?
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId      String?
  deal        Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@index([workspaceId, occurredAt])
  @@index([workspaceId, companyId])
  @@index([workspaceId, dealId])
}

/// One row per LLM-backed request: tokens, estimated cost, latency, outcome.
model AiUsage {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature      AiFeature
  provider     String
  model        String
  inputTokens  Int
  outputTokens Int
  costUsd      Decimal   @db.Decimal(12, 6)
  latencyMs    Int
  toolCalls    Int       @default(0)
  success      Boolean
  errorCode    String?
  createdAt    DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

/// A saved copilot chat. It is private to the user who started it: every read
/// and write filters on both `workspaceId` and `userId`.
model Conversation {
  id              String                @id @default(cuid())
  workspaceId     String
  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  /// Incremented atomically to allocate `ConversationMessage.seq` values.
  messageCount    Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  messages        ConversationMessage[]
  proposedActions ProposedAction[]

  @@index([workspaceId, userId, updatedAt])
}

/// One transcript entry. `content` is provider-neutral JSON (validated with Zod
/// when read), so a conversation can be continued after switching providers.
model ConversationMessage {
  id             String                  @id @default(cuid())
  conversationId String
  conversation   Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  seq            Int
  role           ConversationMessageRole
  content        Json
  createdAt      DateTime                @default(now())

  @@unique([conversationId, seq])
}

/// A change proposed by the copilot. Nothing is written to the CRM until the
/// user approves it through a regular authenticated API call.
model ProposedAction {
  id             String               @id @default(cuid())
  workspaceId    String
  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  kind           ProposedActionKind
  status         ProposedActionStatus @default(pending)
  /// The exact request body that approval executes (re-validated on approval).
  payload        Json
  /// Confirmation card content: title, target and before/after rows.
  preview        Json
  /// `Deal.updatedAt` when proposed; approval is refused if the deal changed since.
  baseVersion    DateTime?
  reason         String?
  resultMessage  String?
  expiresAt      DateTime
  decidedAt      DateTime?
  createdAt      DateTime             @default(now())

  @@index([workspaceId, userId, status])
  @@index([conversationId])
}
