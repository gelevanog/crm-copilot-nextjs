{
  "name": "@crm/api",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS API: CRM domain modules plus the AI module (tool calling, structured outputs, rate limiting, usage accounting).",
  "files": [
    "dist",
    "prisma",
    "docker-entrypoint.sh"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx src/seed/run-seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx src/seed/run-seed.ts --reset",
    "transcript": "tsx scripts/capture-transcript.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@crm/shared": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "~6.19.0",
    "nestjs-pino": "^4.4.1",
    "openai": "^6.3.0",
    "pino": "^9.13.0",
    "pino-http": "^10.5.0",
    "prisma": "~6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.13.5",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.1.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.4"
  }
}
